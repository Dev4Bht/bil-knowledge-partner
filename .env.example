# Copy to .env and change the values. .env is git-ignored. None of these are real secrets.
APP_ENV=dev

# PostgreSQL (also used by the compose file)
POSTGRES_USER=bil
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=bil
POSTGRES_HOST_PORT=5440
DATABASE_URL=postgresql+psycopg://bil:change-me-postgres@localhost:5440/bil

# Original documents: local filesystem by default. To use an S3-compatible server instead, set
# OBJECT_STORE_BACKEND=s3 and fill in the S3_* values.
OBJECT_STORE_BACKEND=filesystem
OBJECT_STORE_PATH=data/objects
# S3_ENDPOINT=localhost:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=bil-documents
# S3_SECURE=false

# API / web
WEB_ORIGIN=http://localhost:3470
NEXT_PUBLIC_API_URL=http://localhost:8000
JWT_SECRET=change-me-long-random-string

# Local LLM via Ollama (runs on the host). Never a cloud API.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Sessions and uploads
COOKIE_SECURE=false            # set true when served over HTTPS
MAX_UPLOAD_MB=25
LOGIN_ATTEMPTS_PER_MINUTE=8

# Demo accounts and fictional fixtures. Ignored when APP_ENV=production.
# Accounts: admin@demo.bil.test, manager@demo.bil.test, staff@demo.bil.test (all use DEMO_PASSWORD)
SEED_DEMO=true
# Fictional test documents (flagged DEMO). Leave false to run on the real public BIL and RMA documents only;
# import those with: uv run python scripts/import_public_documents.py --password "$DEMO_PASSWORD"
SEED_FIXTURES=false
DEMO_PASSWORD=change-me-demo-password
