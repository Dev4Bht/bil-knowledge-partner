# Copy to .env and change the values. .env is git-ignored. None of these are real secrets.
APP_ENV=dev

# PostgreSQL (also used by the compose file)
POSTGRES_USER=bil
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=bil
DATABASE_URL=postgresql+psycopg://bil:change-me-postgres@localhost:5432/bil

# MinIO (S3-compatible object store for original documents)
MINIO_ROOT_USER=bil_minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=bil_minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=bil-documents
MINIO_SECURE=false

# API / web
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
JWT_SECRET=change-me-long-random-string

# Local LLM via Ollama (runs on the host). Never a cloud API.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
